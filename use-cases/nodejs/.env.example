# API Configuration
API_KEY=sk_live_your_actual_api_key
API_BASE_URL=http://localhost:3001
TEMPLATE_ID=resume-modern-professional

# Email Provider Selection
# Options: mailgun, resend, sendgrid, smtp
EMAIL_PROVIDER=mailgun

# Email Configuration
EMAIL_TO=recipient@example.com
EMAIL_FROM=sender@yourdomain.com

# Mailgun Configuration (required if EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.yourdomain.com

# Resend Configuration (required if EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your_resend_api_key

# SendGrid Configuration (required if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# SMTP Configuration (required if EMAIL_PROVIDER=smtp)
# Works with Gmail, Outlook, AWS SES, and other SMTP servers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
