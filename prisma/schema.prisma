generator client {
  provider = "prisma-client"
  output   = "../app/generated"
}

datasource db {
  provider = "postgresql"
}

model UserAccount {
  id                        String                        @id @default(cuid(2))
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  email                     String                        @unique
  name                      String                        @default("")
  imageUrl                  String                        @default("")
  usedInviteLinks           InviteLinkUse[]
  notificationPanels        NotificationPanel[]
  notificationRecipient     NotificationRecipient[]
  createdEmailInvites       OrganizationEmailInviteLink[]
  createdInviteLinks        OrganizationInviteLink[]
  memberships               OrganizationMembership[]
  stripeSubscriptionsBought StripeSubscription[]
  createdApiKeys            OrganizationApiKey[]
  createdDeals              Deal[]                        @relation("DealCreatedBy")
  createdDealVersions       DealDocumentVersion[]         @relation("DealVersionCreatedBy")
  dealMessages              DealMessage[]                 @relation("DealMessageAuthor")
  dealEvents                DealEvent[]                   @relation("DealEventActor")
}

model Organization {
  id                          String                        @id @default(cuid(2))
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  name                        String
  /// We avoid conflicts from slugs by using Prisma middleware. See the file
  /// `app/utils/database.server.ts`.
  slug                        String                        @unique
  imageUrl                    String                        @default("")
  billingEmail                String                        @default("")
  stripeCustomerId            String?                       @unique
  /// We set this to 14 days from now by default in the Prisma middleware.
  trialEnd                    DateTime
  /// When a member chose to skip the dashboard's setup guide. Until then, an
  /// organization without checkout pages or payments sees the guide.
  setupGuideDismissedAt       DateTime?
  notifications               Notification[]
  notificationPanels          NotificationPanel[]
  organizationEmailInviteLink OrganizationEmailInviteLink[]
  organizationInviteLinks     OrganizationInviteLink[]
  memberships                 OrganizationMembership[]
  stripeSubscriptions         StripeSubscription[]
  apiKey                      OrganizationApiKey?
  templates                   Template[]
  checkoutPages               CheckoutPage[]
  products                    Product[]
  customers                   Customer[]
  workflows                   Workflow[]
  deals                       Deal[]
  documentSequences           DocumentSequence[]
  payments                    Payment[]
}

model OrganizationMembership {
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  memberId       String
  organizationId String
  deactivatedAt  DateTime?
  role           OrganizationMembershipRole @default(member)
  member         UserAccount                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([memberId, organizationId])
}

model OrganizationInviteLink {
  id             String          @id @default(cuid(2))
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizationId String
  creatorId      String?
  expiresAt      DateTime
  token          String          @unique @default(cuid(2))
  deactivatedAt  DateTime?
  linkUsages     InviteLinkUse[]
  creator        UserAccount?    @relation(fields: [creatorId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model InviteLinkUse {
  id           String                 @id @default(cuid(2))
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  inviteLinkId String
  userId       String?
  inviteLink   OrganizationInviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  user         UserAccount?           @relation(fields: [userId], references: [id])

  @@unique([inviteLinkId, userId])
}

model OrganizationEmailInviteLink {
  id             String                     @id @default(cuid(2))
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organizationId String
  invitedById    String?
  email          String
  token          String                     @unique @default(cuid(2))
  role           OrganizationMembershipRole @default(member)
  expiresAt      DateTime
  deactivatedAt  DateTime?
  invitedBy      UserAccount?               @relation(fields: [invitedById], references: [id])
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ContactSalesFormSubmission {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyName String
  firstName   String
  lastName    String
  message     String   @default("")
  phoneNumber String   @default("")
  workEmail   String
}

model StripeProduct {
  stripeId String        @id
  name     String
  /// Max seats is set via the `metadata` field of the product as `max_seats`.
  maxSeats Int
  active   Boolean
  prices   StripePrice[]
}

model StripeSubscription {
  /// The Stripe subscription's real ID
  stripeId          String                      @id
  organizationId    String
  purchasedById     String?
  /// Time at which the object was created. Stripe measures it in in seconds
  /// since the Unix epoch, but we convert it to a Date.
  created           DateTime
  /// If the subscription has been canceled with the at_period_end flag set to
  /// true, cancel_at_period_end on the subscription will be true. You can use
  /// this attribute to determine whether a subscription that has a status of
  /// active is scheduled to be canceled at the end of the current period.
  cancelAtPeriodEnd Boolean
  /// Possible values are incomplete, incomplete_expired, trialing, active,
  /// past_due, canceled, unpaid, or paused.
  status            StripeSubscriptionStatus
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchasedBy       UserAccount?                @relation(fields: [purchasedById], references: [id])
  items             StripeSubscriptionItem[]
  schedule          StripeSubscriptionSchedule?
}

model StripeSubscriptionItem {
  stripeId             String             @id
  stripeSubscriptionId String
  /// End of the current period that the subscription item has been invoiced for.
  /// At the end of this period, a new invoice will be created.
  currentPeriodEnd     DateTime
  /// Start of the current period that the subscription item has been invoiced for.
  currentPeriodStart   DateTime
  priceId              String
  price                StripePrice        @relation(fields: [priceId], references: [stripeId], onDelete: Cascade)
  stripeSubscription   StripeSubscription @relation(fields: [stripeSubscriptionId], references: [stripeId], onDelete: Cascade)
}

model StripePrice {
  stripeId          String                            @id
  lookupKey         String                            @unique
  productId         String
  currency          String
  active            Boolean
  unitAmount        Int
  interval          StripePriceInterval
  product           StripeProduct                     @relation(fields: [productId], references: [stripeId], onDelete: Cascade)
  subscriptionItems StripeSubscriptionItem[]
  schedulePhases    StripeSubscriptionSchedulePhase[]
}

model StripeSubscriptionSchedule {
  stripeId          String                            @id
  subscriptionId    String                            @unique
  created           DateTime
  currentPhaseStart DateTime?
  currentPhaseEnd   DateTime?
  subscription      StripeSubscription                @relation(fields: [subscriptionId], references: [stripeId], onDelete: Cascade)
  phases            StripeSubscriptionSchedulePhase[]
}

model StripeSubscriptionSchedulePhase {
  id         String                     @id @default(cuid(2))
  scheduleId String
  startDate  DateTime
  endDate    DateTime
  priceId    String
  quantity   Int
  price      StripePrice                @relation(fields: [priceId], references: [stripeId], onDelete: Cascade)
  schedule   StripeSubscriptionSchedule @relation(fields: [scheduleId], references: [stripeId], onDelete: Cascade)
}

model Notification {
  id             String                  @id @default(cuid(2))
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organizationId String
  content        Json
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients     NotificationRecipient[]
}

model NotificationRecipient {
  id             String       @id @default(cuid(2))
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notificationId String
  userId         String
  /// When the user marked it read
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

model NotificationPanel {
  id             String       @id @default(cuid(2))
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userId         String
  organizationId String
  /// When badge was last cleared
  lastOpenedAt   DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Template {
  id                          String         @id @default(cuid(2))
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  name                        String
  type                        TemplateType
  organizationId              String
  sections                    Json
  globalStyles                Json
  colorPalette                Json?
  sourceTemplateId            String?
  organization                Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkoutPagesUsingAsReceipt CheckoutPage[] @relation("CheckoutReceiptTemplate")
  workflowSteps               WorkflowStep[]
  dealSteps                   DealStep[]
  generatedReceipts           Receipt[]

  @@index([organizationId, type])
  @@map("templates")
}

model CheckoutPage {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  slug        String  @unique
  description String?

  sections     Json
  globalStyles Json
  colorPalette Json?

  receiptTemplateId String?
  receiptTemplate   Template? @relation("CheckoutReceiptTemplate", fields: [receiptTemplateId], references: [id])

  paymentProviders  String[]
  defaultCurrency   String   @default("USD")
  allowedCurrencies String[]

  isPasswordProtected Boolean @default(false)
  passwordHash        String?
  passwordHint        String?

  isActive  Boolean   @default(true)
  expiresAt DateTime?

  viewCount         Int @default(0)
  paymentCount      Int @default(0)
  totalRevenueMinor Int @default(0)

  payments Payment[]

  @@index([organizationId])
  @@index([slug])
  @@index([isActive])
}

model Payment {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Set for payments taken on a checkout page.
  checkoutPageId String?
  checkoutPage   CheckoutPage? @relation(fields: [checkoutPageId], references: [id], onDelete: Cascade)

  /// Set for payments toward a deal's payment step, online or recorded by hand.
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealStepId String?
  dealStep   DealStep? @relation(fields: [dealStepId], references: [id], onDelete: SetNull)

  provider           String
  providerPaymentId  String
  providerCustomerId String?

  amountMinor Int
  currency    String
  status      PaymentStatus

  customerEmail  String
  customerName   String?
  customerPhone  String?
  billingAddress Json?

  items   Json
  receipt Receipt?

  metadata Json?

  @@unique([provider, providerPaymentId])
  @@index([organizationId, createdAt])
  @@index([checkoutPageId])
  @@index([dealId])
  @@index([providerPaymentId])
  @@index([status])
  @@index([customerEmail])
}

model Receipt {
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateId String
  template   Template @relation(fields: [templateId], references: [id])

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  sections     Json
  globalStyles Json
  colorPalette Json?

  receiptNumber String   @unique
  issuedAt      DateTime @default(now())

  sentToEmail String?
  sentAt      DateTime?

  @@index([paymentId])
  @@index([receiptNumber])
}

model OrganizationApiKey {
  id             String       @id @default(cuid(2))
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String       @unique
  /// Encrypted API key - encrypted using AES-256-GCM, never exposed in responses
  encryptedKey   String
  /// First 8 characters of the key for display purposes (e.g., "sk_live_")
  keyPrefix      String
  createdById    String?
  createdBy      UserAccount? @relation(fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_api_keys")
}

enum OrganizationMembershipRole {
  owner
  admin
  member
}

enum StripeSubscriptionStatus {
  /// The subscription is paid and active.
  active
  /// The subscription is canceled. This status is terminal. The user will
  /// need to resubscribe from scratch again.
  canceled
  /// The initial payment for the subscription failed. Stripe is waiting for
  /// the first invoice to be paid. Only metadata and default_source can be
  /// updated.
  incomplete
  /// The subscription's first invoice wasn't paid within 23 hours. The
  /// subscription has expired without ever becoming active. This status is
  /// terminal.
  incomplete_expired
  /// A recurring invoice payment failed after a previously active subscription.
  /// Stripe automatically retries the payment (up to 4 times over about 3–4
  /// weeks by default, using Smart Retries). If all retries fail, the
  /// subscription moves to canceled or unpaid, depending on your subscription
  /// settings.
  past_due
  /// The subscription is temporarily paused. No invoices are generated during
  /// the pause.
  paused
  /// The subscription is in a free trial period before the first payment is due.
  trialing
  /// Payment has failed and all retry attempts have been exhausted. The
  /// subscription remains technically active but is marked as unpaid. New
  /// invoices are not generated.
  unpaid
}

enum StripePriceInterval {
  day
  week
  month
  year
}

enum TemplateType {
  resume
  invoice
  certificate
  reportCards
  receipt
  quote
  proposal
  contract
  purchaseOrder
  salesOrder
  orderConfirmation
  packingSlip
  deliveryNote
  estimate
  statement
  letter
  form
  label
}

enum PaymentStatus {
  pending
  processing
  succeeded
  failed
  canceled
  refunded
  partially_refunded
}

/// An item in an organization's catalogue that documents and deals are built
/// from. Money is stored in minor units (e.g. kobo, cents).
model Product {
  id             String       @id @default(cuid(2))
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String       @default("")
  /// Optional stock-keeping unit, unique within the organization.
  sku            String?
  unitPriceMinor Int
  currency       String
  /// What one unit is, e.g. "item", "hour", "kg".
  unit           String       @default("item")
  /// Tax rate in basis points (750 = 7.5%).
  taxRateBps     Int          @default(0)
  imageUrl       String       @default("")
  archivedAt     DateTime?

  @@unique([organizationId, sku])
  @@index([organizationId, archivedAt])
}

/// Someone an organization sells to.
model Customer {
  id              String       @id @default(cuid(2))
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  /// Stored lower-case.
  email           String
  phone           String       @default("")
  companyName     String       @default("")
  billingAddress  String       @default("")
  shippingAddress String       @default("")
  notes           String       @default("")
  archivedAt      DateTime?
  deals           Deal[]

  @@unique([organizationId, email])
  @@index([organizationId, name])
}

/// What a workflow step does: send a document, collect a payment, or issue a
/// receipt for the payment before it.
enum WorkflowStepKind {
  document
  payment
  receipt
}

/// How a step starts once the step before it is done.
enum StepAdvanceMode {
  /// Sent or issued straight away.
  automatic
  /// Prepared, then waits for someone in the organization to review and send.
  manual
}

/// What a document step's lines are built from.
enum StepCarryForward {
  /// The items of the latest accepted document (or products picked for the
  /// first document).
  items
  /// One line: a percentage of the latest priced document's total.
  deposit
  /// One line: what's left of that total after payments so far.
  balance
}

/// A reusable sequence of documents and payments, usually started from a
/// sample, that deals follow.
model Workflow {
  id             String         @id @default(cuid(2))
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String         @default("")
  /// The sample it was created from, if any.
  sampleKey      String?
  archivedAt     DateTime?
  steps          WorkflowStep[]
  deals          Deal[]

  @@index([organizationId, archivedAt])
}

model WorkflowStep {
  id                 String           @id @default(cuid(2))
  workflowId         String
  workflow           Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position           Int
  kind               WorkflowStepKind
  name               String
  /// The document to send (document steps); receipt steps always use receipt.
  documentType       TemplateType?
  /// The organization's template to use; null means its default for the type.
  templateId         String?
  template           Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  requiresAcceptance Boolean          @default(false)
  advanceMode        StepAdvanceMode  @default(manual)
  carryForward       StepCarryForward @default(items)
  /// For deposit steps, in basis points (5000 = 50%).
  depositPercentBps  Int?
  /// Quotes and estimates: days until they expire.
  validityDays       Int?
  /// Invoices: days until payment is due.
  paymentTermsDays   Int?

  @@unique([workflowId, position])
}

enum DealStatus {
  open
  won
  lost
  cancelled
}

/// Who did something on a deal.
enum DealParty {
  business
  customer
  system
}

enum DealStepStatus {
  /// Not reached yet.
  pending
  /// The step the deal is on.
  active
  done
}

enum DealDocumentStatus {
  /// Prepared, not sent to the customer yet.
  draft
  sent
  viewed
  changesRequested
  accepted
  declined
}

enum DealVersionState {
  /// The version the document shows.
  current
  /// Replaced by a later version.
  superseded
  /// The customer suggested it and the business hasn't decided yet.
  proposed
  /// The customer suggested it and the business turned it down.
  rejected
}

/// One run of a workflow for one customer.
model Deal {
  id             String         @id @default(cuid(2))
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String?
  workflow       Workflow?      @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  /// The workflow's name when the deal started.
  workflowName   String
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  title          String
  currency       String
  status         DealStatus     @default(open)
  closedAt       DateTime?
  /// Signed into the share link. Changing it makes old links stop working.
  shareNonce     String         @default(cuid(2))
  shareRevokedAt DateTime?
  createdById    String?
  createdBy      UserAccount?   @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  steps          DealStep[]
  documents      DealDocument[]
  messages       DealMessage[]
  events         DealEvent[]
  payments       Payment[]

  @@index([organizationId, status, updatedAt])
  @@index([customerId])
}

/// A copy of a workflow step taken when the deal started, so later changes to
/// the workflow don't change running deals.
model DealStep {
  id                 String           @id @default(cuid(2))
  dealId             String
  deal               Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  position           Int
  kind               WorkflowStepKind
  name               String
  documentType       TemplateType?
  templateId         String?
  template           Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  requiresAcceptance Boolean          @default(false)
  advanceMode        StepAdvanceMode  @default(manual)
  carryForward       StepCarryForward @default(items)
  depositPercentBps  Int?
  validityDays       Int?
  paymentTermsDays   Int?
  status             DealStepStatus   @default(pending)
  startedAt          DateTime?
  completedAt        DateTime?
  /// Payment steps: what's due, set when the step starts.
  amountDueMinor     Int?
  /// Payment steps: what was paid and how.
  amountPaidMinor    Int?
  paidAt             DateTime?
  paymentMethod      String           @default("")
  paymentReference   String           @default("")
  document           DealDocument?
  payments           Payment[]

  @@unique([dealId, position])
}

/// The document a document or receipt step produces.
model DealDocument {
  id                String                @id @default(cuid(2))
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  dealId            String
  deal              Deal                  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  stepId            String                @unique
  step              DealStep              @relation(fields: [stepId], references: [id], onDelete: Cascade)
  type              TemplateType
  /// e.g. QUO-0003. Given when the document is first sent.
  number            String?
  status            DealDocumentStatus    @default(draft)
  issuedAt          DateTime?
  /// Quotes and estimates: when they expire. Invoices: when payment is due.
  dueAt             DateTime?
  sentAt            DateTime?
  acceptedAt        DateTime?
  acceptedVersionId String?
  acceptedByName    String                @default("")
  declinedAt        DateTime?
  declineReason     String                @default("")
  versions          DealDocumentVersion[]

  @@index([dealId])
}

/// One set of lines and totals for a document. Every change is a new version,
/// which makes up the deal's trail.
model DealDocumentVersion {
  id             String           @id @default(cuid(2))
  createdAt      DateTime         @default(now())
  dealDocumentId String
  dealDocument   DealDocument     @relation(fields: [dealDocumentId], references: [id], onDelete: Cascade)
  version        Int
  proposedBy     DealParty
  state          DealVersionState
  /// `[{ productId, name, description, unit, quantity, unitPriceMinor, taxRateBps, discountBps }]`
  items          Json
  subtotalMinor  Int
  discountMinor  Int              @default(0)
  taxMinor       Int
  totalMinor     Int
  note           String           @default("")
  createdById    String?
  createdBy      UserAccount?     @relation("DealVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// The document as sent: template sections with the deal's data filled in.
  sections       Json?
  globalStyles   Json?
  colorPalette   Json?

  @@unique([dealDocumentId, version])
}

model DealMessage {
  id        String       @id @default(cuid(2))
  createdAt DateTime     @default(now())
  dealId    String
  deal      Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author    DealParty
  userId    String?
  user      UserAccount? @relation("DealMessageAuthor", fields: [userId], references: [id], onDelete: SetNull)
  body      String

  @@index([dealId, createdAt])
}

/// The deal's trail. Rows are only ever added.
model DealEvent {
  id         String       @id @default(cuid(2))
  createdAt  DateTime     @default(now())
  dealId     String
  deal       Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type       String
  actor      DealParty
  userId     String?
  user       UserAccount? @relation("DealEventActor", fields: [userId], references: [id], onDelete: SetNull)
  documentId String?
  payload    Json         @default("{}")
  ip         String       @default("")
  userAgent  String       @default("")

  @@index([dealId, createdAt])
}

/// The next number for each document type, per organization (QUO-0001, …).
model DocumentSequence {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           TemplateType
  next           Int          @default(1)

  @@id([organizationId, type])
}
